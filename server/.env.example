# Copy this file to ".env" (never commit .env)
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/brambo
# Use a long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
TOKEN_TTL=7d
# Optional (production): comma-separated list of allowed frontend origins. Empty = any localhost port.
# CLIENT_ORIGIN=https://brambo.example.com
